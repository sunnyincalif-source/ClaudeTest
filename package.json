{
  "name": "leettrace-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint && prettier --check .",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "engine:test": "cd packages/engine && uv run pytest",
    "engine:lint": "cd packages/engine && uv run ruff check . && uv run ruff format --check . && uv run mypy",
    "engine:dev": "cd packages/engine && uv run leettrace start",
    "fixtures": "cd packages/engine && uv run python scripts/export_fixtures.py"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/node": "22",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "5",
    "globals": "^17.13.0",
    "prettier": "3",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
