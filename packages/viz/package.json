{
  "name": "@leettrace/viz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared, language-agnostic trace visualization components (React).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./viz.css": "./src/viz.css",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@leettrace/schema": "workspace:^",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16",
    "@types/react": "18",
    "@types/react-dom": "18",
    "jsdom": "26",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
