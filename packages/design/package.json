{
  "name": "@leettrace/design",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "LeetTrace design system: color/type/shape/motion tokens (CSS + TS), fonts, shared component styles.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./components.css": "./src/components.css",
    "./brand.svg": "./src/brand.svg"
  },
  "scripts": {
    "gen": "node scripts/gen.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
