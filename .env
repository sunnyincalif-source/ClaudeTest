# Shared build-time settings for apps/site, apps/web (the app's welcome page) and
# apps/extension. Vercel / CI environment variables with the same names override these.

# Public URL of the site (apps/site): install-guide links in the app and extension.
VITE_LEETTRACE_SITE_URL=https://leettrace.vercel.app

# GitHub repo whose Releases host the downloads (owner/name).
VITE_GITHUB_REPO=sunny925bay-jpg/leettrace

# STORE_URL — the Chrome Web Store listing. One switch for the site and the app's welcome
# page: empty = "Add to Chrome" shows the Load-unpacked steps; set = it links to the store.
VITE_CHROME_STORE_URL=

# Extra Chrome extension IDs the app's page may hand the token to (comma-separated). Only
# needed if the Web Store assigns an ID different from the pinned key's (see RELEASING.md).
VITE_EXTRA_EXTENSION_IDS=
