{
  "name": "@leettrace/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LeetTrace browser extension (MV3): visualize your solution on the LeetCode tab.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/build-firefox.mjs && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "e2e": "node e2e/extension.e2e.mjs",
    "package": "pnpm build"
  },
  "dependencies": {
    "@leettrace/schema": "workspace:^",
    "@leettrace/viz": "workspace:^",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16",
    "@types/chrome": "^0.3.5",
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "4",
    "fflate": "0.8.2",
    "jsdom": "26",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
